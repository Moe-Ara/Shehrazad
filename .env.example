# Copy to .env and fill in. Never commit .env.
# Keep comments on their own lines (not after a value).

# --- required -------------------------------------------------------------------
DISCORD_TOKEN=

# --- environment ----------------------------------------------------------------
# production | staging | development
ENVIRONMENT=production
LOG_LEVEL=INFO
# Structured JSON logs (recommended in production)
LOG_JSON=true
# Staging: sync slash commands to one test server instantly
# DEV_GUILD_ID=
# SYNC_COMMANDS=true

# --- product links (shown in /about, /support, /privacy, /premium) ---------------
# SUPPORT_URL=https://discord.gg/your-support-server
# WEBSITE_URL=https://moe-ara.github.io/Shehrazad/
# TERMS_URL=https://moe-ara.github.io/Shehrazad/terms.html
# PRIVACY_URL=https://moe-ara.github.io/Shehrazad/privacy.html
# Channel (in your support server) that receives /feedback reports
# FEEDBACK_CHANNEL_ID=

# --- premium (Discord Premium Apps) -----------------------------------------------
# Comma-separated guild-subscription SKU IDs from Developer Portal -> Monetization.
# Leave empty until monetization is approved; premium then only comes from CLI grants.
# PREMIUM_SKU_IDS=

# --- owner -------------------------------------------------------------------------
# Discord user IDs allowed to use the owner-only novelty commands (empty = the app's owner)
# OWNER_IDS=
# Servers that get /heybabe, /whereareyou, /comehere, /goaway (never registered globally)
# NOVELTY_GUILD_IDS=

# --- top.gg ------------------------------------------------------------------------
# Project token from the top.gg dashboard (Integrations & API). When set, the bot posts its server
# count every 30 minutes so the listing and widgets show real numbers.
# TOPGG_TOKEN=

# --- music sources ----------------------------------------------------------------
ENABLED_PROVIDERS=youtube,direct
# true = any public https audio URL (private/internal IPs are always blocked)
ALLOW_DIRECT_URLS=false
SHOW_ARTWORK=true

# --- capacity & retention (see docs/commercial-cost-model.md) ----------------------
# Free servers are refused above SOFT, premium servers above HARD. ~20 fits 1 vCPU.
MAX_SESSIONS_SOFT=20
MAX_SESSIONS_HARD=25
HISTORY_RETENTION_DAYS=30
DEPARTED_GUILD_RETENTION_DAYS=30
FEEDBACK_RETENTION_DAYS=90

# --- health endpoint (0 disables /healthz, /readyz, /metrics) ----------------------
HEALTH_PORT=8080
