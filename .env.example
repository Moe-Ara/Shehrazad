# Copy to .env and fill in. Never commit .env.

# --- required -----------------------------------------------------------------
DISCORD_TOKEN=

# --- environment ----------------------------------------------------------------
ENVIRONMENT=production            # production | staging | development
LOG_LEVEL=INFO
LOG_JSON=true                     # structured logs for production
# DEV_GUILD_ID=                   # staging: sync commands to one test server instantly
# SYNC_COMMANDS=true

# --- product / links (shown in /about, /support, /privacy, /premium) -------------
# APPLICATION_ID=                 # your app's ID; used for the invite link (auto-detected at login)
# SUPPORT_URL=https://discord.gg/your-support-server
# WEBSITE_URL=
# TERMS_URL=
# PRIVACY_URL=
# FEEDBACK_CHANNEL_ID=            # channel in your support server that receives /feedback

# --- premium (Discord Premium Apps) ---------------------------------------------
# Comma-separated guild-subscription SKU IDs from the Developer Portal → Monetization.
# Leave empty until monetization is approved; premium then only comes from CLI grants.
# PREMIUM_SKU_IDS=

# --- music sources ---------------------------------------------------------------
ENABLED_PROVIDERS=youtube,direct
ALLOW_DIRECT_URLS=false           # true = any public https audio URL (private IPs are always blocked)
SHOW_ARTWORK=true

# --- legacy ! prefix commands (needs the privileged Message Content intent) ---------
LEGACY_PREFIX_COMMANDS=false
LEGACY_PREFIX=!

# --- capacity & retention ---------------------------------------------------------
MAX_SESSIONS_SOFT=50              # free servers are refused above this
MAX_SESSIONS_HARD=75              # premium servers are refused above this
HISTORY_RETENTION_DAYS=30
DEPARTED_GUILD_RETENTION_DAYS=30
FEEDBACK_RETENTION_DAYS=90

# --- health endpoint --------------------------------------------------------------
HEALTH_PORT=8080                  # 0 disables /healthz, /readyz, /metrics
